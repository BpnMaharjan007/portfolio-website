source "https://rubygems.org"
gem "github-pages", group: :jekyll_plugins

# Windows has no zoneinfo database, so tzinfo cannot resolve the
# `timezone: Asia/Kathmandu` in _config.yml and the build dies before it
# reads a single page. Platform-gated: GitHub Pages builds on Linux with its
# own bundle and never sees this.
gem "tzinfo-data", platforms: %i[windows jruby]
